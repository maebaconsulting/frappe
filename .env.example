# Variables du service Dokploy. À copier en .env pour un essai local,
# ou à saisir dans l'onglet « Environment » du service côté Dokploy.

# Image construite par le workflow GitHub Actions.
# Tag mobile : suit la dernière construction.
# Tag immuable : ghcr.io/maebaconsulting/frappe:version-16-20260803-120000
ERP_IMAGE=ghcr.io/maebaconsulting/frappe:version-16

# Nom du site Frappe. Doit être identique au domaine servi par Traefik,
# sans quoi Frappe répond « Site not found ».
SITE_NAME=erp.mowoapp.com

# Mot de passe du compte Administrator du site.
ADMIN_PASSWORD=a-remplacer-par-un-mot-de-passe-fort

# Mot de passe root de MariaDB.
DB_ROOT_PASSWORD=a-remplacer-par-un-mot-de-passe-fort

# Migration automatique de la base au démarrage de la pile.
# Laisser à true en fonctionnement normal. Passer à false pour déployer une
# nouvelle image sans jouer bench migrate, par exemple pour prendre une
# sauvegarde entre les deux, puis relancer la migration à la main.
MIGRATE_SITES=true
